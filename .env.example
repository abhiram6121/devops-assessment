# Application
APP_NAME=DevOps Assessment Dashboard
ENVIRONMENT=development

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=devops_assessment

# S3-Compatible Storage (LocalStack)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://127.0.0.1:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=devops-assessment-files
PRESIGNED_URL_EXPIRATION_SECONDS=300

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://app.debyez.localhost,http://api.debyez.localhost

# Frontend API URL
VITE_API_BASE_URL=http://localhost:8000/api
