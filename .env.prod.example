# Application
APP_NAME=DevOps Assessment Dashboard
ENVIRONMENT=production

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=devops_assessment

# S3-Compatible Storage (MiniStack)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://ministack:4566
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
S3_BUCKET_NAME=devops-assessment-files
PRESIGNED_URL_EXPIRATION_SECONDS=300

# CORS Origins
CORS_ORIGINS=http://app.debyez.localhost,http://api.debyez.localhost

# Docker Image Registry
DOCKERHUB_USERNAME=armdebug
IMAGE_TAG=latest
